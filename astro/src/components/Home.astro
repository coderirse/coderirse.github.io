---
import Base from '../layouts/Base.astro';
import WorkWall from './WorkWall.astro';
import { getPosts, T, LANG_PREFIX, type Lang } from '../lib/site';
import { readProjects } from '../lib/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang];
const prefix = LANG_PREFIX[lang];

const posts = await getPosts(lang);
const projects = readProjects(lang).slice(0, 8);
const siteName = 'lizhichao';
---

<Base
  lang={lang}
  title={`${siteName} — Create infinite possibilities`}
  description={t.aboutLine.replace(/<[^>]+>/g, '')}
  veil
>
  <!-- 刊头 -->
  <header class="hero">
    <canvas id="binary-rain"></canvas>
    <div class="hero-fade"></div>
    <div class="hero-inner">
      <div class="hero-eyebrow">{t.eyebrow}</div>
      <h1 class="hero-slogan">
        <span class="row"><span class="word">Create</span></span>
        <span class="row"><span class="word"><em>infinite</em></span></span>
        <span class="row"><span class="word">possibilities</span></span>
      </h1>
      <div class="hero-sub"><span>{t.tagline}</span></div>
    </div>
    <div class="hero-scroll">SCROLL ↓</div>
  </header>

  <!-- 跑马灯 -->
  <div class="marquee" aria-hidden="true">
    <div class="mq-track">
      {Array.from({ length: 2 }).map(() => (
        <>
          {Array.from({ length: 3 }).map(() => (
            <>
              <span>CREATE INFINITE POSSIBILITIES <b>◆</b></span>
              <span>CODE <b>◆</b></span>
              <span>ROBOTICS <b>◆</b></span>
              <span>AI <b>◆</b></span>
              <span>WRITING <b>◆</b></span>
              <span>OPEN SOURCE <b>◆</b></span>
            </>
          ))}
        </>
      ))}
    </div>
  </div>

  <!-- 宣言 -->
  <section class="act manifesto">
    <p data-reveal>{t.manifesto}</p>
  </section>

  <!-- 文章墙：巨字背景 + 窗口卡片 -->
  <WorkWall lang={lang} posts={posts} word="WRITING" />

  <!-- 项目 -->
  <section class="act projects-act" style="padding-top: 5rem; padding-bottom: 5rem;">
    <div class="act-label">
      <span class="no">ACT 02</span>
      <span class="name">{t.projects}</span>
      <span class="en">{t.projectsEn}</span>
    </div>
    <div>
      {projects.map((pr, i) => (
        <a class="proj-row" href={`${prefix}/projects/`} data-reveal>
          <span class="idx">{String(i + 1).padStart(2, '0')}</span>
          <span>
            <span class="p-title">{pr.title}</span>
            {pr.blurb && <span class="p-blurb" style="display:block">{pr.blurb}</span>}
          </span>
          <span class="p-arrow">→</span>
        </a>
      ))}
    </div>
    <div style="margin-top:2.5rem">
      <a class="hx-btn" href={`${prefix}/projects/`}>{t.allProjects} →</a>
    </div>
  </section>

  <!-- 关于我 -->
  <section class="act about-act">
    <div class="act-label">
      <span class="no">ACT 03</span>
      <span class="name">{t.about}</span>
      <span class="en">{t.aboutEn}</span>
    </div>
    <div class="about-grid">
      <div class="about-mark" data-reveal>LZ</div>
      <div>
        <p class="about-line" data-reveal set:html={t.aboutLine} />
        <div class="about-links" data-reveal>
          <a href="https://github.com/coderirse" target="_blank" rel="noopener">GITHUB</a>
          <a href="mailto:caeamer@163.com">EMAIL</a>
          <a href={`${prefix}/about/`}>{t.nav.about.toUpperCase()}</a>
          <a href={`${prefix}/resume/`}>{t.nav.resume.toUpperCase()}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
