---
import '../styles/global.css';
import { T, HTML_LANG, LANG_PREFIX, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  bodyClass?: string;
  veil?: boolean;
  altUrls?: Partial<Record<Lang, string>>;
}

const { lang, title, description, bodyClass, veil = false, altUrls = {} } = Astro.props;
const t = T[lang];
const prefix = LANG_PREFIX[lang];
const path = Astro.url.pathname;
const isActive = (p: string) => path === `${prefix}${p}` || (p !== '/' && path.startsWith(`${prefix}${p}`));
const langTargets: Record<Lang, string> = {
  zh: altUrls.zh || '/',
  en: altUrls.en || '/en/',
  ja: altUrls.ja || '/ja/'
};
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/img/touxiang.png" />
    <link rel="stylesheet" href="/css/fonts.css" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class={bodyClass} data-veil={veil ? '1' : undefined}>
    <nav class="nav" id="nav">
      <a class="brand" href={`${prefix}/`}>lizhichao<em>.</em></a>
      <div class="menu">
        <a href={`${prefix}/`} class:list={{ 'is-active': path === `${prefix}/` }}>{t.nav.home}</a>
        <a href={`${prefix}/about/`} class:list={{ 'is-active': isActive('/about/') }}>{t.nav.about}</a>
        <a href={`${prefix}/resume/`} class:list={{ 'is-active': isActive('/resume/') }}>{t.nav.resume}</a>
        <a href={`${prefix}/projects/`} class:list={{ 'is-active': isActive('/projects/') }}>{t.nav.projects}</a>
        <div class="lang-switch">
          <button class="lang-btn" type="button">{lang.toUpperCase()}</button>
          <div class="lang-list">
            <a href={langTargets.zh} class:list={{ active: lang === 'zh' }}>中文</a>
            <a href={langTargets.en} class:list={{ active: lang === 'en' }}>EN</a>
            <a href={langTargets.ja} class:list={{ active: lang === 'ja' }}>日本語</a>
          </div>
        </div>
      </div>
    </nav>

    <slot />

    <footer class="footer">
      <p class="footer-giant">Create <em>infinite</em>
possibilities</p>
      <div class="footer-row">
        <span>© 2026 lizhichao · caeamer</span>
        <span>Keep moving, keep building.</span>
        <span>
          <a href="https://github.com/coderirse" target="_blank" rel="noopener">GITHUB</a> ·
          <a href="mailto:caeamer@163.com">EMAIL</a>
        </span>
      </div>
    </footer>

    <script is:inline src="/js/vendor/lenis.min.js"></script>
    <script is:inline src="/js/vendor/gsap.min.js"></script>
    <script is:inline src="/js/vendor/ScrollTrigger.min.js"></script>
    <script is:inline src="/js/app.js"></script>
  </body>
</html>
