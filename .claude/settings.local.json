{
  "permissions": {
    "allow": [
      "WebFetch(domain:caeamer.com)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(npm run *)",
      "Bash(ls public/en/index.html)",
      "Bash(ls public/ja/index.html)",
      "Bash(echo \"exit: $?\")",
      "Bash(curl -sI -o /dev/null -w \"%{http_code} %{redirect_url}\" \"https://caeamer.com/projects/\")",
      "Bash(curl -s \"https://caeamer.com/projects/\")",
      "Bash(curl -sI -o /dev/null -w \"%{http_code} %{redirect_url}\" \"https://caeamer.com/en/about/\")",
      "Bash(curl -sI -o /dev/null -w \"%{http_code} %{redirect_url}\" \"https://caeamer.com/ja/about/\")",
      "Bash(node -e ' *)"
    ]
  }
}
